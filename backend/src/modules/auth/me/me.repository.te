import { Building } from "../../buildings/building.model.js";
import { Person } from "../../people/people.model.js";
import { Role } from "../../roles/role.model.js";
import { UnitPeople } from "../../unit-people/unit-people.model.js";
import { Unit } from "../../units/unit.model.js";
import { User } from "../../users/user.model.js";
import { UserBuildingRole } from "../../users-buildings-roles/user-building-role.model.js";

export class MeRepository {
  findUser(userId: string) {
    return User.findByPk(userId, {
      attributes: ["id", "email", "status", "personId"],
      include: [
        {
          model: Person,
          as: "person",
          attributes: ["firstName", "lastName"],
        },
      ],
    });
  }

  findBuildingRoles(userId: string) {
    return UserBuildingRole.findAll({
      where: { userId },
      attributes: ["roleId", "buildingId"],
      include: [
        { model: Role, as: "role", attributes: ["name"] },
        {
          model: Building,
          as: "building",
          attributes: ["id", "name"],
        },
      ],
    });
  }

  findActiveUnits(personId: string) {
    return UnitPeople.findAll({
      where: { personId, endDate: null },
      attributes: ["relationshipType", "startDate"],
      include: [
        {
          model: Unit,
          as: "unit",
          attributes: ["id", "buildingId", "code", "floor"],
        },
      ],
    });
  }
}