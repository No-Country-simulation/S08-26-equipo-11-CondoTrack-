PORT=3000
NODE_ENV=development

DATABASE_URL=postgresql://usuario:contraseña@ep-some-example.us-east-2.aws.neon.tech/dbname?sslmode=require

JWT_SECRET=clave_secreta
JWT_EXPIRES_IN=90d

GOOGLE_CLIENT_ID=tu_client_id
